# ==============================================================================
# FORAGER x HUBSPOT ENRICHMENT AUTOMATION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Forager API Settings ---
# Get your API key and Account ID from https://app.forager.ai -> API section
FORAGER_API_KEY=your_forager_api_key_here
FORAGER_ACCOUNT_ID=your_forager_numeric_account_id_here
FORAGER_BASE_URL=https://api-v2.forager.ai

# --- HubSpot API & Webhook Settings ---
# Private App token (starts with pat-na1-...) from Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here
# Developer App Client Secret (UUID format) used to validate X-HubSpot-Signature-v3
HUBSPOT_CLIENT_SECRET=your_hubspot_developer_app_client_secret_here
# Set to true in production when public webhooks are sent from HubSpot
VERIFY_WEBHOOK_SIGNATURE=false

# --- Deployment / Hosting ---
# Public URL of your deployed service (e.g. https://forager-hubspot-enrichment.up.railway.app)
PUBLIC_BASE_URL=http://localhost:8000

# --- Credit & Safety Guardrails ---
# DRY_RUN: When true, NO real calls are made to Forager. Uses high-fidelity mocks.
DRY_RUN=true
# Maximum number of credits allowed to be consumed in a single execution run
MAX_CREDITS_PER_RUN=30
# Default number of people to discover at a company if not specified
DEFAULT_CONTACT_LIMIT=5
# Default comma-separated job titles to filter contacts when discovering people
DEFAULT_TITLE_FILTERS=CEO,CTO,VP,Head of,Director,Founder,Co-Founder,President,Chief Executive Officer,Chief Technology Officer
# Controls whether expensive phone (15 credits) and email (5 credits) reveals are queried in live mode
ENABLE_EMAIL_PHONE_REVEAL=false

# --- Dashboard Security ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme_in_production

# --- Application & Storage ---
LOG_LEVEL=INFO
# SQLite database path. For Railway persistent volume, you can point to /data/enrichment.db
DATABASE_URL=sqlite:///./enrichment.db
